# Optional: enables provider-backed history on startup.
# A 24-hour request requires a plan that supports a 1,440-minute history window.
LIGHTNING_API_KEY=

# Optional: Met Office Weather DataHub NSWWS v1.1 subscription API key.
# Keep this server-side. See docs/phase-1.md for setup and access requirements.
METOFFICE_WARNINGS_API_KEY=

# Optional local bind overrides.
STORMTRACE_HOST=127.0.0.1
STORMTRACE_PORT=4177

# Optional radar decoder: absolute Python path from an EXTERNAL venv with requirements-radar.txt.
# Keep venvs outside the plugin directory: Omarchy rejects their symlinks during updates.
STORMTRACE_RADAR_PYTHON=
